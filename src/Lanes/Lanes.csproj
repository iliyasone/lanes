<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- For UI Automation (the taskbar's buttons), which comes with WPF. -->
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Lanes</AssemblyName>
    <RootNamespace>Lanes</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    
    <Version>0.3.0</Version>
    <ApplicationIcon>../../assets/icon.ico</ApplicationIcon>
    <NoWarn>CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- WPF leaves these out of the usual implicit usings. -->
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../third_party/VirtualDesktopAccessor.dll" LogicalName="VirtualDesktopAccessor.dll" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Lanes.Core/Lanes.Core.csproj" />
  </ItemGroup>
</Project>
